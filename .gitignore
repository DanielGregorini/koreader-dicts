# Fetched source data and generated dictionaries NEVER go in git. They are
# downloaded or built on demand and published to GitHub Releases; a clone stays
# small and fast.
/data/*
!/data/README.md
# Everything under dictionaries/ except the catalog, which is small metadata
# the site build reads. Git cannot re-include a file inside an excluded
# directory, so the contents are excluded rather than the directory itself.
/dictionaries/*
!/dictionaries/catalog.json
!/dictionaries/README.md
/build/
/dist/
/cache/
/out/


AGENTS.md

